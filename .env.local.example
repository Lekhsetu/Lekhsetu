# Supabase (free tier – create project at https://supabase.com)
# Find these in: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — used by /api/auth/reset-password to reset a forgotten
# password after security questions are verified. NEVER prefix this with
# NEXT_PUBLIC_ and never expose it to the browser. Find it in
# Project Settings → API → service_role (keep secret).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: AI writing assistant — set ANY ONE (or more) of these free keys.
# They are tried in order: Groq -> OpenRouter -> Gemini. If a provider isn't
# configured (no key) it's skipped silently; if one fails/rate-limits, the
# next configured one is tried automatically.

# Groq (recommended — fast, generous free tier, no card required)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (free models, good fallback)
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Gemini (free tier, rate-limited)
# Get a free key at https://aistudio.google.com
GEMINI_API_KEY=

# Used for SEO metadata, sitemap, and social share previews — set to your real domain
NEXT_PUBLIC_SITE_URL=https://lekhsetu.com

# Optional: Google Analytics (GA4) — realtime traffic, pick up your Measurement ID
# from Google Analytics → Admin → Data Streams. Leave blank to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional: Google AdSense — publisher ID from AdSense → Account → Account information.
# Leave blank to disable.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
